{
  "name": "mcp-server-mongodb",
  "version": "0.1.0",
  "description": "MCP server that gives LLMs safe, read-only access to MongoDB.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "bson": "^7.3.0",
    "mongodb": "^7.7.0",
    "pino": "^10.4.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.0",
    "eslint": "^10.13.0",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
